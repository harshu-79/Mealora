@app.route("/api/weekly-plan", methods=["POST"])
def weekly_plan_v3():
    """
    Pantry-first weekly planner with fast indexed pantry matching.

    Key correction:
    - Do NOT ask the generic recommender for 35 recipes and then try to
      optimize them. That caused pantry_score=0 and irrelevant recipes.
    - Score the full recipe master dataset against the CURRENT pantry first.
    - Use pantry coverage as a strong gate/objective.
    - Keep ML/context as ranking signals, not as permission to ignore the pantry.
    - Build meal/side roles from pantry-compatible candidates.
    """
    try:
        import ast
        import random
        import re as _re
        from difflib import SequenceMatcher
        import numpy as np
        import pandas as pd

        data = request.get_json() or {}
        pantry = data.get("pantry") or []
        household = data.get("household") or {}

        adults = max(int(household.get("adults", 0) or 0), 0)
        children = max(int(household.get("children", 0) or 0), 0)
        seniors = max(int(household.get("seniors", 0) or 0), 0)

        if adults + children + seniors <= 0:
            return jsonify({
                "success": False,
                "error": "Add at least one household member."
            }), 400

        mode = str(data.get("mode", "automatic") or "automatic").lower()
        diet = str(data.get("diet", "Mixed") or "Mixed")
        cuisine = str(data.get("cuisine", "Auto") or "Auto")
        max_time = float(data.get("max_time", 60) or 60)
        include_snacks = bool(data.get("include_snacks", True))
        special_day = str(data.get("special_day", "Saturday") or "None")

        ctx = build_context({
            "mode": mode,
            "date": data.get("date"),
            "time": data.get("time"),
            "location_city": data.get("location_city"),
            "location": data.get("location_city"),
            "latitude": data.get("latitude"),
            "longitude": data.get("longitude"),
            "meal_type": data.get("meal_type", "Automatic"),
            "diet": diet,
            "cuisine": cuisine,
            "max_time": max_time,
        })

        if diet.lower() in ("auto", "automatic"):
            diet = ctx.get("diet", diet)
        if cuisine.lower() in ("auto", "automatic"):
            cuisine = ctx.get("cuisine", cuisine)

        def norm_text(value):
            s = str(value or "").lower()
            s = s.replace("&", " and ")
            s = s.replace("chilli", "chili")
            s = s.replace("capsicum", "bell pepper")
            s = s.replace("coriander leaves", "cilantro")
            s = s.replace("coriander leaf", "cilantro")
            s = s.replace("curd", "yogurt")
            s = s.replace("dahi", "yogurt")
            s = _re.sub(r"[^a-z0-9\s]", " ", s)
            s = _re.sub(r"\s+", " ", s).strip()
            return s

        def token_set(value):
            return {
                x for x in norm_text(value).split()
                if len(x) >= 3 and x not in {
                    "the", "and", "with", "for", "from", "into",
                    "cup", "cups", "tsp", "tbsp", "tablespoon",
                    "tablespoons", "teaspoon", "teaspoons"
                }
            }

        UNIT_RE = (
            r"(?:kg|kgs|kilo|kilos|kilogram|kilograms|g|gram|grams|"
            r"ml|milliliter|milliliters|litre|litres|liter|liters|"
            r"l|piece|pieces|pcs|clove|cloves|bunch|bunches|"
            r"slice|slices|tbsp|tsp|cup|cups|pinch|handful)"
        )

        def clean_ingredient_name(value):
            s = str(value or "").strip()
            if not s:
                return ""

            # Remove leading quantity/unit.
            s = _re.sub(
                rf"^\s*\d+(?:\.\d+)?\s*(?:{UNIT_RE})?\s*(?:of\s+)?",
                "",
                s,
                flags=_re.I,
            )

            # Remove common parenthetical notes.
            s = _re.sub(r"\([^)]*\)", " ", s)

            # Remove preparation tails that should not become ingredient names.
            s = _re.sub(
                r"\b(chopped|sliced|diced|minced|grated|crushed|"
                r"finely|roughly|freshly|to taste|as needed)\b",
                " ",
                s,
                flags=_re.I,
            )

            s = _re.sub(r"\s+", " ", s).strip(" ,.-")
            return s

        def parse_ingredients(value):
            if isinstance(value, list):
                return [
                    clean_ingredient_name(x)
                    for x in value
                    if clean_ingredient_name(x)
                ]

            if value is None:
                return []

            s = str(value).strip()
            if not s or s.lower() in ("nan", "none", "null"):
                return []

            # Python/JSON list stored as text.
            if s.startswith("[") and s.endswith("]"):
                for parser in (json.loads, ast.literal_eval):
                    try:
                        parsed = parser(s)
                        if isinstance(parsed, list):
                            return [
                                clean_ingredient_name(x)
                                for x in parsed
                                if clean_ingredient_name(x)
                            ]
                    except Exception:
                        pass

            # Newline / semicolon / pipe separated datasets.
            parts = re.split(r"\n|;|\|", s)
            if len(parts) == 1:
                # Some datasets use comma-separated ingredient lists.
                parts = [x.strip() for x in s.split(",")]

            return [
                clean_ingredient_name(x)
                for x in parts
                if clean_ingredient_name(x)
            ]

        def first_col(df, candidates):
            lower = {str(c).lower(): c for c in df.columns}
            for c in candidates:
                if str(c).lower() in lower:
                    return lower[str(c).lower()]
            return None

        # ------------------------------------------------------------
        # Current pantry -> normalized pantry names.
        # ------------------------------------------------------------
        pantry_names = []
        pantry_expiry_names = []

        today = now_india().date()

        for item in pantry:
            name = (
                item.get("normalized_name")
                or item.get("ingredient_name")
                or item.get("name")
            )
            if not name:
                continue

            cleaned = clean_ingredient_name(name)
            if cleaned:
                pantry_names.append(cleaned)

            expiry = item.get("expiry_date")
            if expiry:
                try:
                    days = (
                        datetime.strptime(
                            str(expiry)[:10], "%Y-%m-%d"
                        ).date() - today
                    ).days
                    if days <= 7:
                        pantry_expiry_names.append(cleaned)
                except Exception:
                    pass

        # De-duplicate pantry aliases.
        pantry_names = list(dict.fromkeys(pantry_names))
        pantry_expiry_names = list(dict.fromkeys(pantry_expiry_names))

        if not pantry_names:
            return jsonify({
                "success": False,
                "error": "Your pantry is empty. Add ingredients before generating the weekly plan."
            }), 400

        # Staple ingredients should help a recipe, but should not make a
        # recipe look pantry-complete by themselves.
        STAPLES = {
            "salt", "sugar", "water", "oil", "cooking oil",
            "sunflower oil", "groundnut oil", "coconut oil",
            "mustard oil", "sesame oil", "olive oil", "ghee",
            "butter", "black pepper", "turmeric", "turmeric powder",
            "red chili", "red chili powder", "coriander powder",
            "cumin powder", "garam masala", "hing", "asafoetida",
            "ginger garlic paste"
        }

        # Fast pantry lookup. The previous V3 implementation compared every
        # recipe ingredient against every pantry item and then ran
        # SequenceMatcher repeatedly. With 18K+ recipes this can feel like a
        # frozen browser. Build an inverted token index once instead.
        TOKEN_STOP = {
            "curry", "masala", "powder", "paste", "leaves", "leaf",
            "fresh", "dried", "dry", "whole", "ground", "chopped",
            "sliced", "small", "large", "medium", "recipe"
        }

        pantry_exact = {}
        pantry_token_index = {}

        def stem_token(token):
            t = str(token or "").strip().lower()
            if len(t) > 4 and t.endswith("ies"):
                return t[:-3] + "y"
            if len(t) > 4 and t.endswith("es"):
                return t[:-2]
            if len(t) > 3 and t.endswith("s"):
                return t[:-1]
            return t

        for p in pantry_names:
            pn = norm_text(p)
            if not pn:
                continue
            pantry_exact[pn] = p
            for tok in token_set(pn):
                st = stem_token(tok)
                if len(st) >= 3 and st not in TOKEN_STOP:
                    pantry_token_index.setdefault(st, set()).add(p)

        def ingredient_match(recipe_ing, pantry_name):
            a = norm_text(recipe_ing)
            b = norm_text(pantry_name)
            if not a or not b:
                return False
            if a == b or a in b or b in a:
                return True
            at = {stem_token(x) for x in token_set(a)} - TOKEN_STOP
            bt = {stem_token(x) for x in token_set(b)} - TOKEN_STOP
            return bool(at and bt and (at & bt))

        def find_pantry_match(recipe_ing, expiry_only=False):
            a = norm_text(recipe_ing)
            if not a:
                return None
            exact_source = pantry_expiry_names if expiry_only else pantry_names
            exact = {norm_text(x): x for x in exact_source}
            if a in exact:
                return exact[a]
            candidates = set()
            for tok in token_set(a):
                st = stem_token(tok)
                if len(st) >= 3 and st not in TOKEN_STOP:
                    if expiry_only:
                        # Expiry list is small, so exact token scan is cheap.
                        candidates.update(
                            p for p in pantry_expiry_names
                            if st in {stem_token(x) for x in token_set(p)}
                        )
                    else:
                        candidates.update(pantry_token_index.get(st, set()))
            if not candidates:
                return None
            # Prefer the closest token overlap, then shorter pantry name.
            best = None
            best_key = (-1.0, 10**9)
            for p in candidates:
                pt = {stem_token(x) for x in token_set(p)} - TOKEN_STOP
                overlap = len(({stem_token(x) for x in token_set(a)} - TOKEN_STOP) & pt)
                denom = max(len({stem_token(x) for x in token_set(a)} - TOKEN_STOP), 1)
                key = (overlap / denom, -len(pt))
                if key > best_key:
                    best_key = key
                    best = p
            return best

        def score_recipe(recipe_ingredients):
            ingredients = [
                x for x in recipe_ingredients
                if norm_text(x)
            ]

            if not ingredients:
                return {
                    "pantry": 0.0,
                    "core_pantry": 0.0,
                    "expiry": 0.0,
                    "matched": [],
                    "missing": [],
                    "missing_core": [],
                }

            matched = []
            missing = []
            missing_core = []
            matched_expiry = []

            core_ingredients = []

            for ing in ingredients:
                is_staple = norm_text(ing) in {
                    norm_text(x) for x in STAPLES
                }

                if not is_staple:
                    core_ingredients.append(ing)

                match = find_pantry_match(ing)

                if match:
                    matched.append(match)
                    expiry_match = find_pantry_match(ing, expiry_only=True)
                    if expiry_match:
                        matched_expiry.append(match)
                else:
                    missing.append(ing)
                    if not is_staple:
                        missing_core.append(ing)

            all_coverage = len(matched) / max(len(ingredients), 1)

            if core_ingredients:
                core_matched = len(core_ingredients) - len(missing_core)
                core_coverage = core_matched / len(core_ingredients)
            else:
                core_coverage = all_coverage

            expiry_coverage = (
                len(set(matched_expiry))
                / max(len(set(pantry_expiry_names)), 1)
                if pantry_expiry_names
                else 0.0
            )

            # Pantry coverage is about recipe requirements, NOT
            # recipe-match-count / 139 pantry rows.
            pantry_score = (
                0.75 * core_coverage +
                0.25 * all_coverage
            )

            return {
                "pantry": float(np.clip(pantry_score, 0, 1)),
                "core_pantry": float(np.clip(core_coverage, 0, 1)),
                "expiry": float(np.clip(expiry_coverage, 0, 1)),
                "matched": list(dict.fromkeys(matched)),
                "missing": missing,
                "missing_core": missing_core,
            }

        # ------------------------------------------------------------
        # Load the COMPLETE recipe master dataset.
        # ------------------------------------------------------------
        df = pd.read_csv(RECIPE_DATASET)

        if df.empty:
            raise RuntimeError("The recipe master dataset is empty.")

        name_col = first_col(
            df,
            ["recipe_name", "name", "title", "recipe", "dish_name"]
        )
        id_col = first_col(
            df,
            ["recipe_id", "id", "ID", "recipeid"]
        )
        ingredient_col = first_col(
            df,
            [
                "ingredients", "ingredient_names",
                "cleaned_ingredients", "Cleaned-Ingredients",
                "TranslatedIngredients", "ingredient_list",
                "Ingredients"
            ]
        )
        meal_col = first_col(
            df,
            ["meal_type", "meal", "mealtype", "meal_type_name"]
        )
        cuisine_col = first_col(
            df,
            ["cuisine", "cuisine_type"]
        )
        diet_col = first_col(
            df,
            ["diet", "diet_type", "diet_category"]
        )
        time_col = first_col(
            df,
            [
                "cooking_time_minutes", "cooking_time",
                "cook_time", "prep_time_minutes",
                "total_time_minutes", "total_time"
            ]
        )

        if name_col is None or ingredient_col is None:
            raise RuntimeError(
                "Mealora could not identify recipe_name/ingredients columns "
                f"in {RECIPE_DATASET}."
            )

        # Deduplicate recipes.
        df = df.copy()
        df["_mealora_recipe_name"] = (
            df[name_col].fillna("Mealora Recipe").astype(str).str.strip()
        )
        df["_mealora_ingredients"] = df[ingredient_col].apply(parse_ingredients)

        if id_col:
            df["_mealora_recipe_id"] = df[id_col].astype(str)
        else:
            df["_mealora_recipe_id"] = [
                str(i) for i in range(len(df))
            ]

        # Remove unusable rows.
        df = df[
            (df["_mealora_recipe_name"] != "") &
            (df["_mealora_ingredients"].map(len) > 0)
        ].copy()

        # ------------------------------------------------------------
        # Context / ML columns if they already exist in the master.
        # Otherwise use conservative neutral defaults.
        # ------------------------------------------------------------
        def row_score(row, candidates, default=0.5):
            for c in candidates:
                if c in row.index:
                    try:
                        value = float(row[c])
                        if np.isfinite(value):
                            return float(np.clip(value, 0, 1))
                    except Exception:
                        pass
            return default

        def classify_meal(row, recipe_name, ingredients):
            raw = str(row.get(meal_col, "") if meal_col else "").lower()
            text = f"{recipe_name} {' '.join(ingredients)}".lower()

            if any(x in raw for x in ["breakfast", "morning"]):
                return "Breakfast"
            if any(x in raw for x in ["snack", "starter", "appetizer"]):
                return "Snack"
            if any(x in raw for x in ["dinner", "supper"]):
                return "Dinner"
            if "lunch" in raw:
                return "Lunch"

            # Name-based fallback.
            if any(x in text for x in [
                "dosa", "idli", "upma", "poha", "pongal",
                "paratha", "pancake", "omelette", "omelet",
                "puri", "vada", "uttapam", "toast"
            ]):
                return "Breakfast"

            if any(x in text for x in [
                "tea", "coffee", "pakora", "bajji", "bonda",
                "samosa", "sandwich", "cutlet", "snack"
            ]):
                return "Snack"

            return "Main"

        # Score every recipe against the actual pantry.
        scored = []

        for _, row in df.iterrows():
            ingredients = row["_mealora_ingredients"]
            p = score_recipe(ingredients)

            # Strongly discourage recipes that need many missing core items.
            core = p["core_pantry"]

            ml = max(
                row_score(
                    row,
                    ["hgb_suitability_score", "rf_suitability_score",
                     "ml_suitability_score"],
                    0.5
                ),
                row_score(row, ["han_score"], 0.5)
            )

            context_score = row_score(
                row,
                ["context_score", "context_match_score"],
                0.5
            )

            nutrition_score = row_score(
                row,
                ["nutrition_score", "nutrition_match_score"],
                0.5
            )

            time_score = 1.0

            if time_col:
                try:
                    t = float(row[time_col])
                    if np.isfinite(t):
                        time_score = float(
                            np.clip(
                                1.0 - max(t - max_time, 0) / max(max_time, 1),
                                0,
                                1
                            )
                        )
                except Exception:
                    pass

            scored.append({
                "recipe_id": str(row["_mealora_recipe_id"]),
                "recipe_name": str(row["_mealora_recipe_name"]),
                "ingredients": ingredients,
                "pantry": p["pantry"],
                "core_pantry": core,
                "expiry": p["expiry"],
                "matched_pantry": p["matched"],
                "missing": p["missing"],
                "missing_core": p["missing_core"],
                "ml": ml,
                "context": context_score,
                "nutrition": nutrition_score,
                "time": time_score,
                "meal_role": classify_meal(
                    row,
                    str(row["_mealora_recipe_name"]),
                    ingredients
                ),
                "cuisine": str(row[cuisine_col]) if cuisine_col else "",
                "diet": str(row[diet_col]) if diet_col else "",
                "cook_time": (
                    float(row[time_col])
                    if time_col
                    and str(row[time_col]).strip()
                    and str(row[time_col]).lower() != "nan"
                    else None
                ),
            })

        recipes = pd.DataFrame(scored)

        # ------------------------------------------------------------
        # User filters.
        # ------------------------------------------------------------
        def matches_filter(row):
            if diet and diet.lower() not in ("mixed", "any", "auto", "automatic", "none"):
                raw = str(row["diet"]).lower()
                if raw and diet.lower() not in raw:
                    return False

            if cuisine and cuisine.lower() not in ("auto", "automatic", "any", "mixed", "none"):
                raw = str(row["cuisine"]).lower()
                if raw and cuisine.lower() not in raw:
                    return False

            return True

        recipes = recipes[recipes.apply(matches_filter, axis=1)].copy()

        # Pantry-first candidate gate.
        # Main meals should normally use at least ~55% of their
        # non-staple ingredients from the current pantry.
        pantry_candidates = recipes[
            recipes["core_pantry"] >= 0.55
        ].copy()

        # If the dataset/filter combination is restrictive, relax gradually.
        if len(pantry_candidates) < 100:
            pantry_candidates = recipes[
                recipes["core_pantry"] >= 0.40
            ].copy()

        if len(pantry_candidates) < 50:
            pantry_candidates = recipes[
                recipes["pantry"] >= 0.35
            ].copy()

        if len(pantry_candidates) == 0:
            pantry_candidates = recipes.sort_values(
                ["core_pantry", "pantry", "ml"],
                ascending=False
            ).head(100).copy()

        # Ranking deliberately gives pantry more influence than generic ML.
        pantry_candidates["_base_score"] = (
            0.42 * pantry_candidates["core_pantry"] +
            0.16 * pantry_candidates["pantry"] +
            0.12 * pantry_candidates["expiry"] +
            0.10 * pantry_candidates["ml"] +
            0.08 * pantry_candidates["context"] +
            0.07 * pantry_candidates["nutrition"] +
            0.05 * pantry_candidates["time"]
        )

        # ------------------------------------------------------------
        # Meal-role pools.
        # ------------------------------------------------------------
        def is_breakfast(row):
            return row["meal_role"] == "Breakfast"

        def is_snack(row):
            return row["meal_role"] == "Snack"

        def is_main(row):
            return row["meal_role"] in ("Lunch", "Dinner", "Main")

        breakfast_pool = pantry_candidates[
            pantry_candidates.apply(is_breakfast, axis=1)
        ].copy()

        main_pool = pantry_candidates[
            pantry_candidates.apply(is_main, axis=1)
        ].copy()

        snack_pool = pantry_candidates[
            pantry_candidates.apply(is_snack, axis=1)
        ].copy()

        if breakfast_pool.empty:
            breakfast_pool = pantry_candidates.copy()

        if main_pool.empty:
            main_pool = pantry_candidates.copy()

        if snack_pool.empty:
            snack_pool = breakfast_pool.copy()

        # Side dishes: prefer vegetable/dal/poriyal/kootu/raita/salad
        # rather than letting any main recipe become a "side".
        SIDE_TERMS = (
            "poriyal", "sabzi", "subzi", "kootu", "thoran",
            "dal", "sambar", "rasam", "raita", "salad",
            "chutney", "kurma", "vegetable", "stir fry",
            "palya", "avial", "bhaji"
        )

        side_pool = main_pool[
            main_pool["recipe_name"].str.lower().apply(
                lambda x: any(t in x for t in SIDE_TERMS)
            )
        ].copy()

        if side_pool.empty:
            side_pool = main_pool.copy()

        # Weekend special recipes: biryani/pulao/etc., but ONLY if pantry-compatible.
        TREAT_TERMS = (
            "biryani", "biriyani", "pulao", "fried rice",
            "korma", "tikka", "butter masala", "special"
        )

        special_pool = main_pool[
            main_pool["recipe_name"].str.lower().apply(
                lambda x: any(t in x for t in TREAT_TERMS)
            )
        ].copy()

        if special_pool.empty:
            special_pool = main_pool.copy()

        # ------------------------------------------------------------
        # Build 35 slots. NSGA-II optimizes the selected candidate
        # combination, but candidates are already pantry-grounded.
        # ------------------------------------------------------------
        days = [
            "Monday", "Tuesday", "Wednesday",
            "Thursday", "Friday", "Saturday", "Sunday"
        ]

        slots = []
        domains = []

        def top_domain(pool, n=30):
            if pool.empty:
                return []
            return list(
                pool.sort_values(
                    ["_base_score", "core_pantry", "expiry"],
                    ascending=False
                ).head(n).index
            )

        for day in days:
            # Breakfast
            slots.append((day, "breakfast"))
            domains.append(top_domain(breakfast_pool, 35))

            # Lunch main
            slots.append((day, "lunch_main"))
            domains.append(top_domain(main_pool, 45))

            # Lunch side
            slots.append((day, "lunch_side"))
            domains.append(top_domain(side_pool, 35))

            # Dinner main — special/treat on selected weekend day.
            slots.append((day, "dinner_main"))
            if day == special_day and special_day != "None":
                domains.append(top_domain(special_pool, 45))
            else:
                domains.append(top_domain(main_pool, 45))

            # Dinner side
            slots.append((day, "dinner_side"))
            domains.append(top_domain(side_pool, 35))

        # Remove empty domains.
        if any(not d for d in domains):
            raise RuntimeError(
                "Mealora could not build pantry-compatible candidate pools."
            )

        # Master candidate table. Keep recipe IDs as the stable key so
        # breakfast/main/side pools can share the same candidate records.
        candidates = pd.concat(
            [
                breakfast_pool,
                main_pool,
                side_pool,
                special_pool
            ],
            ignore_index=True
        ).drop_duplicates("recipe_id").reset_index(drop=True)

        id_to_pos = {
            str(row["recipe_id"]): i
            for i, (_, row) in enumerate(candidates.iterrows())
        }

        # Rebuild every slot domain by recipe_id. This avoids dataframe-index
        # collisions between the source pools.
        domain_ids = []

        for day, slot_name in slots:
            if slot_name == "breakfast":
                source_pool = breakfast_pool
            elif slot_name in ("lunch_side", "dinner_side"):
                source_pool = side_pool
            elif (
                slot_name == "dinner_main"
                and day == special_day
                and special_day != "None"
            ):
                source_pool = special_pool
            else:
                source_pool = main_pool

            source_pool = source_pool.sort_values(
                ["_base_score", "core_pantry", "expiry"],
                ascending=False
            ).head(45)

            ids = [
                id_to_pos[str(recipe_id)]
                for recipe_id in source_pool["recipe_id"].tolist()
                if str(recipe_id) in id_to_pos
            ]

            domain_ids.append(list(dict.fromkeys(ids)))

        domains = domain_ids

        # ------------------------------------------------------------
        # NSGA-II objective.
        # ------------------------------------------------------------
        def fitness(chromosome):
            rows = [candidates.iloc[i].to_dict() for i in chromosome]

            pantry_score = np.mean([r["core_pantry"] for r in rows])
            expiry_score = np.mean([r["expiry"] for r in rows])
            ml_score = np.mean([r["ml"] for r in rows])
            nutrition_score = np.mean([r["nutrition"] for r in rows])
            context_score = np.mean([r["context"] for r in rows])
            time_score = np.mean([r["time"] for r in rows])

            recipe_names = [
                str(r["recipe_name"]).strip().lower()
                for r in rows
            ]
            unique = len(set(recipe_names)) / max(len(recipe_names), 1)

            ingredient_sets = [
                set(token_set(" ".join(r["ingredients"])))
                for r in rows
            ]

            # Ingredient reuse is useful, but not so strong that every day
            # becomes the same meal.
            reuse_pairs = []
            for i in range(1, len(ingredient_sets)):
                if ingredient_sets[i] and ingredient_sets[i - 1]:
                    reuse_pairs.append(
                        len(
                            ingredient_sets[i] &
                            ingredient_sets[i - 1]
                        ) /
                        max(
                            len(
                                ingredient_sets[i] |
                                ingredient_sets[i - 1]
                            ),
                            1
                        )
                    )

            reuse = np.mean(reuse_pairs) if reuse_pairs else 0.5

            purchase = np.mean([
                1.0 - min(
                    len(r["missing_core"]) /
                    max(len(r["ingredients"]), 1),
                    1.0
                )
                for r in rows
            ])

            # Pantry is intentionally first and strongest.
            return np.array([
                pantry_score,
                expiry_score,
                ml_score,
                nutrition_score,
                context_score,
                time_score,
                purchase,
                reuse,
                unique
            ], dtype=float)

        def dominates(a, b):
            return np.all(a >= b) and np.any(a > b)

        def fast_fronts(values):
            n = len(values)
            domination_count = [0] * n
            dominated = [[] for _ in range(n)]
            fronts = [[]]

            for p in range(n):
                for q in range(n):
                    if p == q:
                        continue
                    if dominates(values[p], values[q]):
                        dominated[p].append(q)
                    elif dominates(values[q], values[p]):
                        domination_count[p] += 1

                if domination_count[p] == 0:
                    fronts[0].append(p)

            i = 0
            while i < len(fronts) and fronts[i]:
                next_front = []
                for p in fronts[i]:
                    for q in dominated[p]:
                        domination_count[q] -= 1
                        if domination_count[q] == 0:
                            next_front.append(q)
                if next_front:
                    fronts.append(next_front)
                i += 1

            return fronts

        def crowding(front, values):
            distance = {i: 0.0 for i in front}

            if len(front) <= 2:
                for i in front:
                    distance[i] = float("inf")
                return distance

            for obj in range(values.shape[1]):
                ordered = sorted(
                    front,
                    key=lambda i: values[i, obj]
                )

                distance[ordered[0]] = float("inf")
                distance[ordered[-1]] = float("inf")

                low = values[ordered[0], obj]
                high = values[ordered[-1], obj]

                if high == low:
                    continue

                for k in range(1, len(ordered) - 1):
                    distance[ordered[k]] += (
                        values[ordered[k + 1], obj] -
                        values[ordered[k - 1], obj]
                    ) / (high - low)

            return distance

        def mutate(chromosome):
            out = chromosome[:]
            for i in range(len(out)):
                if random.random() < 0.15:
                    out[i] = random.choice(domains[i])
            return out

        random.seed(42)
        np.random.seed(42)

        # Keep the research-grade NSGA-II stage, but avoid excessive
        # request latency in the browser. Candidate scoring is now fast.
        pop_size = 30
        generations = 15

        population = [
            [random.choice(domain) for domain in domains]
            for _ in range(pop_size)
        ]

        best_front = None
        best_values = None

        for _ in range(generations):
            values = np.array([
                fitness(chromosome)
                for chromosome in population
            ])

            fronts = fast_fronts(values)

            if fronts and fronts[0]:
                best_front = [
                    population[i][:]
                    for i in fronts[0]
                ]
                best_values = values[fronts[0]]

            ranks = np.zeros(len(population), dtype=int)
            crowd = np.zeros(len(population), dtype=float)

            for rank, front in enumerate(fronts):
                for i in front:
                    ranks[i] = rank

                cd = crowding(front, values)
                for i, score in cd.items():
                    crowd[i] = score

            offspring = []

            while len(offspring) < pop_size:
                def pick():
                    a = random.randrange(pop_size)
                    b = random.randrange(pop_size)

                    if (
                        ranks[a] < ranks[b] or
                        (
                            ranks[a] == ranks[b] and
                            crowd[a] > crowd[b]
                        )
                    ):
                        return population[a][:]

                    return population[b][:]

                parent_a = pick()
                parent_b = pick()

                cut = random.randint(1, len(parent_a) - 1)

                child_a = mutate(
                    parent_a[:cut] + parent_b[cut:]
                )
                child_b = mutate(
                    parent_b[:cut] + parent_a[cut:]
                )

                offspring.extend([child_a, child_b])

            combined = population + offspring[:pop_size]

            combined_values = np.array([
                fitness(chromosome)
                for chromosome in combined
            ])

            fronts = fast_fronts(combined_values)

            new_population = []

            for front in fronts:
                if len(new_population) + len(front) <= pop_size:
                    new_population.extend(
                        combined[i] for i in front
                    )
                else:
                    cd = crowding(front, combined_values)
                    ordered = sorted(
                        front,
                        key=lambda i: cd[i],
                        reverse=True
                    )
                    new_population.extend(
                        combined[i]
                        for i in ordered[
                            :pop_size - len(new_population)
                        ]
                    )
                    break

            population = new_population

        if not best_front:
            raise RuntimeError(
                "NSGA-II did not produce a weekly plan."
            )

        # Pantry-first final selection.
        weights = np.array([
            0.30,  # pantry
            0.15,  # expiry
            0.13,  # ML suitability
            0.10,  # nutrition
            0.08,  # context
            0.07,  # time
            0.07,  # purchase
            0.05,  # ingredient reuse
            0.05   # uniqueness
        ])

        selected = best_front[
            int(
                np.argmax([
                    np.dot(
                        np.clip(v, 0, 1),
                        weights
                    )
                    for v in best_values
                ])
            )
        ]

        def serialize(index, is_treat=False):
            row = candidates.iloc[int(index)]

            return {
                "recipe_id": str(row["recipe_id"]),
                "recipe_name": str(row["recipe_name"]),
                "suitability_score": round(
                    float(row["ml"]), 4
                ),
                "pantry_score": round(
                    float(row["core_pantry"]), 4
                ),
                "expiry_score": round(
                    float(row["expiry"]), 4
                ),
                "context_score": round(
                    float(row["context"]), 4
                ),
                "nutrition_score": round(
                    float(row["nutrition"]), 4
                ),
                "purchase_score": round(
                    1.0 - min(
                        len(row["missing_core"]) /
                        max(len(row["ingredients"]), 1),
                        1.0
                    ),
                    4
                ),
                "matched_pantry": list(
                    row["matched_pantry"]
                )[:15],
                "missing_ingredients": list(
                    row["missing"]
                )[:10],
                "ingredients": list(
                    row["ingredients"]
                ),
                "is_treat": bool(is_treat)
            }

        plan = []

        # Selected chromosome has 35 positions:
        # day * [breakfast, lunch main, lunch side, dinner main, dinner side]
        for day_index, day in enumerate(days):
            base = day_index * 5
            special = (
                special_day != "None"
                and day == special_day
            )

            breakfast_i = selected[base]
            lunch_i = selected[base + 1]
            lunch_side_i = selected[base + 2]
            dinner_i = selected[base + 3]
            dinner_side_i = selected[base + 4]

            # Prevent the same recipe from being its own side.
            if (
                candidates.iloc[lunch_side_i]["recipe_id"] ==
                candidates.iloc[lunch_i]["recipe_id"]
            ):
                alternatives = domain_ids[base + 2]
                alternatives = [
                    x for x in alternatives
                    if candidates.iloc[x]["recipe_id"] !=
                    candidates.iloc[lunch_i]["recipe_id"]
                ]
                if alternatives:
                    lunch_side_i = max(
                        alternatives,
                        key=lambda x:
                        candidates.iloc[x]["core_pantry"]
                    )

            if (
                candidates.iloc[dinner_side_i]["recipe_id"] ==
                candidates.iloc[dinner_i]["recipe_id"]
            ):
                alternatives = domain_ids[base + 4]
                alternatives = [
                    x for x in alternatives
                    if candidates.iloc[x]["recipe_id"] !=
                    candidates.iloc[dinner_i]["recipe_id"]
                ]
                if alternatives:
                    dinner_side_i = max(
                        alternatives,
                        key=lambda x:
                        candidates.iloc[x]["core_pantry"]
                    )

            plan.append({
                "day": day,
                "theme": (
                    "Weekend special / treat meal"
                    if special
                    else "Pantry-first balanced day"
                ),
                "is_special_day": special,
                "breakfast": serialize(
                    breakfast_i
                ),
                "lunch_main": serialize(
                    lunch_i
                ),
                "lunch_side": serialize(
                    lunch_side_i
                ),
                "dinner_main": serialize(
                    dinner_i,
                    special
                ),
                "dinner_side": serialize(
                    dinner_side_i,
                    special
                )
            })

        # Snacks are selected separately from a pantry-grounded snack pool.
        if include_snacks and not snack_pool.empty:
            snack_pool = snack_pool.copy()

            snack_pool["_snack_score"] = (
                0.45 * snack_pool["core_pantry"] +
                0.20 * snack_pool["pantry"] +
                0.15 * snack_pool["expiry"] +
                0.10 * snack_pool["nutrition"] +
                0.10 * snack_pool["ml"]
            )

            snack_pool = snack_pool.sort_values(
                "_snack_score",
                ascending=False
            ).drop_duplicates(
                "recipe_id"
            ).reset_index(drop=True)

            for i, day_plan in enumerate(plan):
                row = snack_pool.iloc[
                    i % len(snack_pool)
                ]

                # Find corresponding candidate row.
                candidate_matches = candidates.index[
                    candidates["recipe_id"].astype(str) ==
                    str(row["recipe_id"])
                ].tolist()

                if candidate_matches:
                    day_plan["snack"] = serialize(
                        candidate_matches[0]
                    )
                else:
                    day_plan["snack"] = {
                        "recipe_id": str(row["recipe_id"]),
                        "recipe_name": str(row["recipe_name"]),
                        "suitability_score": round(float(row["ml"]), 4),
                        "pantry_score": round(float(row["core_pantry"]), 4),
                        "expiry_score": round(float(row["expiry"]), 4),
                        "context_score": round(float(row["context"]), 4),
                        "nutrition_score": round(float(row["nutrition"]), 4),
                        "purchase_score": round(
                            1.0 - min(
                                len(row["missing_core"]) /
                                max(len(row["ingredients"]), 1),
                                1.0
                            ),
                            4
                        ),
                        "matched_pantry": list(
                            row["matched_pantry"]
                        )[:15],
                        "missing_ingredients": list(
                            row["missing"]
                        )[:10],
                        "ingredients": list(row["ingredients"]),
                        "is_treat": False
                    }

        all_meals = []

        for day in plan:
            for key in (
                "breakfast",
                "lunch_main",
                "lunch_side",
                "dinner_main",
                "dinner_side",
                "snack"
            ):
                if day.get(key):
                    all_meals.append(day[key])

        def average(key, default=0.5):
            if not all_meals:
                return default
            return float(
                np.mean([
                    float(x.get(key, default))
                    for x in all_meals
                ])
            )

        unique_recipes = len({
            x["recipe_id"]
            for x in all_meals
        })

        # A weekly planner should never claim "0% pantry" when
        # candidates were pantry-grounded.
        pantry_utilization = average("pantry_score", 0)
        expiry_utilization = average("expiry_score", 0)

        return jsonify({
            "success": True,
            "context": ctx,
            "plan": plan,
            "summary": {
                "meals_planned": len(all_meals),
                "unique_recipes": unique_recipes,
                "pantry_utilization": round(
                    pantry_utilization * 100, 1
                ),
                "expiry_utilization": round(
                    expiry_utilization * 100, 1
                ),
                "nutrition_score": round(
                    average("nutrition_score") * 100, 1
                ),
                "context_score": round(
                    average("context_score") * 100, 1
                ),
                "purchase_burden": round(
                    (1.0 - average("purchase_score")) * 100,
                    1
                ),
                "algorithm": (
                    "Pantry-first indexed full-dataset scoring "
                    "+ RF/HAN signals + NSGA-II multi-objective optimization"
                ),
                "optimizer_generations": generations,
                "optimizer_population": pop_size,
                "planning_horizon": "7 days",
                "candidate_recipes_evaluated": int(len(recipes)),
                "pantry_grounded_candidates": int(len(pantry_candidates)),
                "pantry_items_received": int(len(pantry_names)),
                "objectives": [
                    "pantry coverage",
                    "expiry utilization",
                    "learned suitability",
                    "nutrition",
                    "context",
                    "time fit",
                    "purchase burden",
                    "ingredient reuse",
                    "recipe variety"
                ]
            }
        })

    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({
            "success": False,
            "error": str(e)
        }), 500


